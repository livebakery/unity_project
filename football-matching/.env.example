# --- Anthropic (AI parser) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model for parsing posts. Default is the most capable model.
# For cheaper/faster parsing you can set this to claude-haiku-4-5.
PARSE_MODEL=claude-opus-4-8

# --- Database (Supabase Postgres) ---
# Pooled connection string for the app (port 6543), and direct for migrations (5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Google Maps ---
# Browser key (restrict by HTTP referrer). Used for the map + Places autocomplete.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# Server key (restrict by IP / API). Used for Geocoding on the server.
GOOGLE_MAPS_SERVER_KEY=AIza...
